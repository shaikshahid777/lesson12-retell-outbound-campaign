    {
      "parameters": {
        "jsCode": "const cfg = $('Campaign Config').first().json;\nconst PROTECTED = ['+15550000002', '+15550000003', '+15550000004'];\nconst IANA_LIKE = /^(UTC|[A-Za-z_]+(\\/[A-Za-z0-9_+\\-]+)+)$/;\nconst nowMs = cfg.now_override ? new Date(cfg.now_override).getTime() : Date.now();\nconst out = [];\nlet slot = 0;\nfor (const item of $input.all()) {\n  const l = item.json;\n  const phone = String(l.phone_number || '').trim();\n  const tz = typeof l.timezone === 'string' ? l.timezone.trim() : '';\n  let reason = null;\n  let localTime = null;\n  if (l.dnc_status === true || String(l.dnc_status).toLowerCase() === 'true') {\n    reason = 'skipped_dnc';\n  } else if (l.dnc_status !== false && String(l.dnc_status).toLowerCase() !== 'false') {\n    reason = 'skipped_dnc_status_unknown';\n  } else if (PROTECTED.includes(phone)) {\n    reason = 'skipped_protected_test_number';\n  } else if (!tz) {\n    reason = 'skipped_timezone_missing';\n  } else if (!IANA_LIKE.test(tz) || Number.isNaN(nowMs)) {\n    reason = 'skipped_timezone_invalid';\n  } else {\n    try {\n      const parts = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(nowMs));\n      const h = Number(parts.find((p) => p.type === 'hour').value);\n      const m = Number(parts.find((p) => p.type === 'minute').value);\n      localTime = String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');\n      const minutes = h * 60 + m;\n      if (!(minutes >= 480 && minutes < 1260)) reason = 'skipped_outside_call_window';\n    } catch (e) {\n      reason = 'skipped_timezone_invalid';\n    }\n  }\n  const decision = reason ? reason : 'eligible';\n  const row = {\n    lead_id: l.lead_id,\n    first_name: l.first_name,\n    phone_number: phone,\n    product_name: l.product_name,\n    timezone: tz,\n    local_time: localTime,\n    decision: decision,\n  };\n  if (!reason) {\n    row.throttle_slot = Math.floor(slot / cfg.max_calls_per_second);\n    slot += 1;\n  }\n  out.push({ json: row });\n}\nreturn out;"
      },
