      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.campaign_call_logs (lead_id, call_sid, call_duration_seconds, outcome_label, recording_url, call_summary, occurred_at)\nSELECT (SELECT lead_id FROM public.campaign_leads WHERE phone_number = $2 LIMIT 1), $1, $3, $4, $5, $6, now()\nON CONFLICT (call_sid) DO NOTHING\nRETURNING call_log_id, call_sid, outcome_label;",
        "options": {
          "queryReplacement": "={{ [$json.call_sid, $json.to_number, $json.call_duration_seconds, $json.outcome_label, $json.recording_url, $json.call_summary] }}"
        }
      },
