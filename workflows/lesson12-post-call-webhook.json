    {
      "parameters": {
        "jsCode": "const call = ($input.first().json.payload || {}).call || {};\nconst reason = call.disconnection_reason;\nlet outcome = 'answered';\nif (call.call_analysis?.custom_analysis_data?.optout_requested === true) outcome = 'opt_out_dnc';\nelse if (reason === 'voicemail_reached') outcome = 'voicemail';\nelse if (reason === 'dial_busy') outcome = 'line_busy';\nelse if (reason === 'dial_no_answer') outcome = 'no_answer';\nelse if (reason === 'dial_failed' || reason === 'invalid_destination') outcome = 'call_failed';\n\nreturn [{ json: {\n  call_sid: call.call_id,\n  to_number: call.to_number,\n  call_duration_seconds: Math.round((call.duration_ms || 0) / 1000),\n  recording_url: call.recording_url || null,\n  call_summary: call.call_analysis?.call_summary || null,\n  outcome_label: outcome.slice(0, 30),\n} }];"
      },
      "id": "8a038192-1735-4508-8fb6-4b3193106f5d",
      "name": "Map Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
