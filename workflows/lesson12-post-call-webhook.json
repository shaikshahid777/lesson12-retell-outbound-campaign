    {
      "parameters": {
        "jsCode": "// Security: API key from n8n Variables ($vars.RETELL_API_KEY) if available, else the placeholder below.\nconst PLACEHOLDER_KEY = 'REPLACE_WITH_RETELL_API_KEY';\nconst crypto = require('crypto');\n\nlet signatureValid = false;\nlet payload = null;\n\ntry {\n  const item = $input.first();\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const rawBody = buf.toString('utf8');\n  try { payload = JSON.parse(rawBody); } catch (e) { payload = null; }\n\n  let apiKey = PLACEHOLDER_KEY;\n  try {\n    if ($vars && $vars.RETELL_API_KEY) apiKey = $vars.RETELL_API_KEY;\n  } catch (e) { /* variables not available */ }\n\n  const headers = item.json.headers || {};\n  const header = headers['x-retell-signature'];\n\n  if (header && typeof header === 'string' && apiKey !== PLACEHOLDER_KEY) {\n    const m = /^v=(\\d+),d=([0-9a-fA-F]+)$/.exec(header.trim());\n    if (m) {\n      const timestamp = m[1];\n      const digest = m[2].toLowerCase();\n      const ageMs = Math.abs(Date.now() - Number(timestamp));\n      if (ageMs <= 5 * 60 * 1000) {\n        const expected = crypto.createHmac('sha256', apiKey).update(rawBody + timestamp).digest('hex');\n        const a = Buffer.from(expected, 'utf8');\n        const b = Buffer.from(digest, 'utf8');\n        signatureValid = a.length === b.length && crypto.timingSafeEqual(a, b);\n      }\n    }\n  }\n} catch (e) {\n  signatureValid = false;\n}\n\nreturn [{ json: { signature_valid: signatureValid, payload: signatureValid ? payload : null } }];"
      },
      "id": "a85ca725-1364-461d-9869-0f186b30d33c",
      "name": "Verify Retell Signature",
      "type": "n8n-nodes-base.code",
